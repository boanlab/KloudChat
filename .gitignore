# ── Logs ───────────────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Node ───────────────────────────────────────────────────────────────────
node_modules
apps/web/node_modules
.tools/
dist
dist-ssr
*.local

# ── Editors ────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Secrets ────────────────────────────────────────────────────────────────
# The compose variable file. Holds KCHAT_JWT_SECRET and, when bootstrapped
# from the environment rather than the admin screen, LITELLM_MASTER_KEY.
.env
.env.local
apps/api/.env

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/
# Left by `pip install -e`.
*.egg-info/

# ── Runtime state ──────────────────────────────────────────────────────────
# Postgres data, uploaded blobs, and the uv dependency cache. Owned by the
# container uid, so it is neither committable nor readable by the host user.
data/

# ── Test output ────────────────────────────────────────────────────────────
test-results/
playwright-report/
blob-report/
.playwright/

# Generated by gen-searxng-config.sh: contains secret_key and is owned by the
# container uid. The committed template is settings.yml.example.
searxng/settings.yml
