# KloudChat configuration. Copy this file to `.env`, fill it in, and the stack
# starts with `docker compose up -d`.
#
# Models and tools live in KloudChat-LLM, not here. The URLs below are boot
# defaults only: whatever an administrator saves under Settings → System is
# written to the database and takes precedence, and applies without a restart.
# Leaving every integration blank and configuring it in the UI is a valid
# deployment.

# ── Required ───────────────────────────────────────────────────────────────
# Signing key for access tokens. Generate one — never ship the example value:
#   openssl rand -hex 32
# Rotating this invalidates every issued access token, which is the intended
# effect after a suspected compromise.
KCHAT_JWT_SECRET=

# ── Backend integration ────────────────────────────────────────────────────
# One gateway URL. Print it from the backend with `./scripts/setup.sh urls`.
# Setting this alone derives the endpoints for models, web search, document
# fetch, code execution, deep research and speech-to-text by appending paths.
BACKEND_BASE_URL=

# The printer — a headless browser that turns a finished HTML document into a
# PDF that looks like the screen. Left as it is, compose runs one beside the API
# and this is where it listens; the service is on a network with no way out, so
# nothing outside the stack can reach it and it cannot reach anything.
#
# Blank turns printing off. Exports still produce a PDF — drawn by the
# structural renderer instead, which carries the words and not the 서식's own
# layout. Set it blank on a deployment that does not run the print container.
KCHAT_PRINT_BASE_URL=http://kloudchat-print:8200

# Only needed when LiteLLM is somewhere other than the gateway above. Left
# blank, both are derived from BACKEND_BASE_URL.
#
# The master key stays inside the API container. No route returns it and the
# browser has no path to it; per-user virtual keys are what upstream calls use.
# 같은 compose 망이면 내부 주소를 적는 것이 안전하다 — 공개 도메인 경유는
# 그 앞 프록시의 타임아웃(흔히 60초)이 긴 문서 생성 호출을 끊는다.
LITELLM_BASE_URL=
LITELLM_MASTER_KEY=

# ── First administrator ────────────────────────────────────────────────────
# Created on startup only when the database has no accounts at all. If an
# account already exists this does nothing, so editing these values later will
# not reset an existing password.
#
# Left blank, the first account to sign up becomes the administrator. Fill both
# in to create one on first boot instead — for unattended deployments, where
# nobody can walk through the signup screen.
#
# **Do not ship a password from this file.** Anything written here is published
# in the repository, so an instance deployed with it has a publicly known
# administrator account.
#
# The address has to be one the sign-in form also accepts, which rules out the
# special-use domains a closed network reaches for first — `.local`, `.test`,
# `localhost`. An address that fails that check is reported at startup and no
# administrator is created, so the first account to sign up becomes one instead.
KCHAT_ADMIN_EMAIL=
KCHAT_ADMIN_PASSWORD=

# Model used for conversation when the user has not chosen one.
KCHAT_DEFAULT_CHAT_MODEL=local/qwen3.6-35b

# The same, for the two surfaces that write a document rather than a turn.
# Empty falls back to the chat model above.
#
# They are separate because the jobs are. Chat is a turn every few seconds and
# is read as it arrives, so decode speed is most of what the person feels; a
# 보고서 or a 발표 자료 is one long run they wait for once, and what they feel
# is whether it needed rewriting. A model three times the decode cost is the
# wrong trade for the first and the right one for the second.
KCHAT_DEFAULT_REPORT_MODEL=
KCHAT_DEFAULT_SLIDES_MODEL=
# The picture surface. Gemini's image models take the aspect ratio as a
# parameter and keep it; the OpenAI ones return a square whatever is asked.
# A model this install does not serve falls back to the cheapest image model.
KCHAT_DEFAULT_IMAGE_MODEL=google/gemini-2.5-flash-image
# 오디오/동영상 is one surface with two kinds of model, so one default each.
KCHAT_DEFAULT_AUDIO_MODEL=openai/gpt-audio-mini
KCHAT_DEFAULT_VIDEO_MODEL=google/veo-3.1-lite

# Names conversations and extracts memories — high volume, so a cheap model
# earns its place. Both uses are best effort: a name this install does not serve
# falls back to the session's own model. Empty does the same, deliberately.
KCHAT_TITLE_MODEL=local/qwen3.6-35b

# ── Optional: policy ───────────────────────────────────────────────────────
# open     — new accounts are active immediately
# approval — new accounts wait for an administrator (default)
# closed   — signup is disabled
KCHAT_SIGNUP_MODE=approval

# Monthly credit allowance for a new account.
# 1 credit = $0.00001, so 1,000,000 ≈ $10/month.
KCHAT_DEFAULT_MONTHLY_CREDITS=1000000

# Set to true behind TLS. The refresh token is an httpOnly cookie; over plain
# HTTP it is readable on the wire.
KCHAT_COOKIE_SECURE=false

# JSON array of the exact origins that serve the app. Credentialed requests
# mean a wildcard is not an option.
KCHAT_CORS_ORIGINS=["http://localhost:5173"]

# Which hops may name the client in X-Forwarded-For. The default covers a
# proxy on the same host or Docker network. Narrow it to your edge proxy's own
# address wherever this port is reachable by anyone else — every address in the
# set can claim to be any client.
#   KCHAT_TRUSTED_PROXIES="set_real_ip_from 10.1.2.3;"
# The proxy in front must send the header; nothing here can invent it.
#KCHAT_TRUSTED_PROXIES=

# Used only for the date the model is told on every turn. Timestamps stay UTC.
#KCHAT_TIMEZONE=Asia/Seoul

# ── Optional: database ─────────────────────────────────────────────────────
# Change both before exposing Postgres beyond the compose network.
KCHAT_DB_USER=kchat
KCHAT_DB_PASSWORD=kchat

# ── Optional: integration checks ───────────────────────────────────────────
# The scripts under scripts/ sign in as an administrator. They read
# KCHAT_ADMIN_EMAIL / KCHAT_ADMIN_PASSWORD above by default.
#
# Set these two only when the account the checks should use is not the
# bootstrap administrator — because the first admin arrived by signing up, or
# because that password has since been changed. The container ignores them.
#ADMIN_EMAIL=
#ADMIN_PASS=
