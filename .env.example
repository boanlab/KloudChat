# KloudChat configuration. Copy to `.env`, fill it in, `docker compose up -d`.
#
# Models and tools live in KloudChat-LLM. The URLs below are boot defaults:
# whatever an administrator saves under Settings → System is stored in the
# database, takes precedence, and applies without a restart. Leaving every
# integration blank and configuring it in the UI is a valid deployment.

# ── Required ───────────────────────────────────────────────────────────────
# Access-token signing key. Generate one — never ship the example value:
#   openssl rand -hex 32
# Rotating it invalidates every issued access token.
KCHAT_JWT_SECRET=

# Key that seals stored secrets (users' model keys, issued API keys, connector
# credentials, secret system settings). Generate one the same way. Empty falls
# back to a key derived from KCHAT_JWT_SECRET, which ties the two rotations
# together; with this set, the API re-seals existing rows on its next start.
KCHAT_SECRET_KEY=

# ── Backend integration ────────────────────────────────────────────────────
# One gateway URL; KloudChat-LLM prints it with `./scripts/setup.sh urls`.
# Setting this alone derives the endpoints for models, web search, document
# fetch, code execution, deep research, speech-to-text and the retrieval index.
#
# This stack does not join KloudChat-LLM's docker network. Write the address
# the API container can reach: the LLM host and its gateway port, the only
# port that stack publishes.
#
#   BACKEND_BASE_URL=http://<llm-host-ip>:8080                # another machine on the LAN
#   BACKEND_BASE_URL=http://host.docker.internal:8080   # the same host as this stack
#
# LiteLLM publishes no port of its own; it is reached as <BACKEND_BASE_URL>/litellm.
# Prefer the LAN address over a public domain: a TLS proxy in front of one
# commonly times out long document calls at 60 seconds.
BACKEND_BASE_URL=

# The gateway answers /tools/* only with this shared key (X-Tools-Key). Use the
# same value as TOOLS_GATEWAY_KEY in KloudChat-LLM's .env. Generate with
#   openssl rand -hex 32
# It is sent only to the tool addresses, never to fetched pages or other MCP
# servers. Blank sends nothing, and a gateway that requires it answers 401.
KCHAT_TOOLS_GATEWAY_KEY=

# KCI Open API key (open.kci.go.kr, free registration) for Korean scholarly
# search with authors, year, journal and DOI. Blank: KCI is searched through
# the search backend within site:kci.go.kr (titles and links only).
KCHAT_KCI_API_KEY=

# The printer: a headless browser that turns a finished HTML document into a
# PDF that matches the screen. Compose runs one beside the API on a network
# with no route out. Blank turns printing off; exports still produce a PDF
# from the structural renderer, without the 서식's own layout.
KCHAT_PRINT_BASE_URL=http://kloudchat-print:8200

# Only when LiteLLM is not behind the gateway above, or the gateway address in
# the admin screen is a public domain and LiteLLM should be called over the LAN:
#
#   LITELLM_BASE_URL=http://host.docker.internal:8080/litellm
#
# Blank derives it from BACKEND_BASE_URL.
#
# The master key never leaves the API container; upstream calls use per-user
# virtual keys.
LITELLM_BASE_URL=
LITELLM_MASTER_KEY=

# ── First administrator ────────────────────────────────────────────────────
# Created on startup only when the database has no accounts; never resets an
# existing password. Blank: the first account to sign up becomes the
# administrator. Fill both in for unattended deployments.
#
# **Do not ship a password from this file.**
#
# The address must pass the sign-in form's check, which rejects special-use
# domains (`.local`, `.test`, `localhost`). A rejected address is reported at
# startup and no administrator is created.
KCHAT_ADMIN_EMAIL=
KCHAT_ADMIN_PASSWORD=

# ── First install only: product choices ───────────────────────────────────
# Which model does which job, whether models think, and a new account's credits
# are decided in the admin screen (System › 모델, System › 회원 가입) and stored
# in the database. These lines only seed a fresh install: the first migration
# run writes them there once and they do nothing afterwards, so on an existing
# install they can be deleted. Leaving them all out gives the defaults shown.
#
# Conversation model when the user has not chosen one.
KCHAT_DEFAULT_CHAT_MODEL=local/qwen3.8-27b
# Report and slides; empty follows the chat model.
KCHAT_DEFAULT_REPORT_MODEL=
KCHAT_DEFAULT_SLIDES_MODEL=
# Picture surface. Gemini's image models honour the aspect ratio; OpenAI's
# return a square.
KCHAT_DEFAULT_IMAGE_MODEL=google/gemini-2.5-flash-image
# 오디오/동영상 is one surface with two kinds of model, so one default each.
KCHAT_DEFAULT_AUDIO_MODEL=openai/gpt-audio-mini
KCHAT_DEFAULT_VIDEO_MODEL=google/veo-3.1-lite
# Conversation titles, memory extraction and the running summary of a long
# conversation (docs/configuration.md, "Which model does what").
KCHAT_TITLE_MODEL=local/qwen3.8-flash
# Whether self-hosted / external chat models may think before answering.
KCHAT_SELF_HOSTED_CHAT_THINKING=false
KCHAT_EXTERNAL_CHAT_THINKING=false
# Monthly credit allowance for a new account. 1 credit = $0.00001, so
# 500,000 ≈ $5/month.
KCHAT_DEFAULT_MONTHLY_CREDITS=500000

# ── Backend facts ──────────────────────────────────────────────────────────
# Comma-separated name fragments of self-hosted models that think unless told
# not to; only these get enable_thinking=false.
KCHAT_SELF_HOSTED_THINKING_MODELS=qwen3.8-flash

# ── Optional: policy ───────────────────────────────────────────────────────
# open     — new accounts are active immediately
# approval — new accounts wait for an administrator (default)
# closed   — signup is disabled
KCHAT_SIGNUP_MODE=approval

# Set to true behind TLS. The refresh token is an httpOnly cookie; over plain
# HTTP it is readable on the wire.
KCHAT_COOKIE_SECURE=false

# JSON array of the exact origins that serve the app. Credentialed requests
# rule out a wildcard.
KCHAT_CORS_ORIGINS=["http://localhost:5173"]

# Hops allowed to name the client in X-Forwarded-For. The default covers a
# proxy on the same host or Docker network. Narrow it to the edge proxy's own
# address wherever this port is reachable by anyone else — every address in
# the set can claim to be any client. The proxy must send the header.
#   KCHAT_TRUSTED_PROXIES="set_real_ip_from 10.1.2.3;"
#KCHAT_TRUSTED_PROXIES=

# Only the date the model is told each turn. Timestamps stay UTC.
#KCHAT_TIMEZONE=Asia/Seoul

# ── Optional: database ─────────────────────────────────────────────────────
# Change both before exposing Postgres beyond the compose network.
KCHAT_DB_USER=kchat
KCHAT_DB_PASSWORD=kchat

# ── Optional: integration checks ───────────────────────────────────────────
# The scripts under scripts/ sign in as an administrator, reading
# KCHAT_ADMIN_EMAIL / KCHAT_ADMIN_PASSWORD above by default. Set these two
# when the checks should use another account. The container ignores them.
#ADMIN_EMAIL=
#ADMIN_PASS=

# Default of the governance switch that keeps turns carrying internal material (attachments,
# project files, memories) on strict-local models. The admin screen's value wins once saved.
# INTERNAL_DATA_STRICT_LOCAL_DEFAULT=true
