{
  "name": "kloudchat-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:personas": "playwright test e2e/personas.spec.ts --reporter=list",
    "test:auth": "playwright test e2e/auth.spec.ts --project=desktop --reporter=list",
    "test:chat": "playwright test e2e/chat.spec.ts --project=desktop --reporter=list",
    "test:workspace": "playwright test e2e/workspace.spec.ts --project=desktop --reporter=list",
    "test:journeys": "playwright test e2e/persona-journeys.spec.ts --project=desktop --reporter=list",
    "test:regress": "playwright test e2e/regress.spec.ts --project=desktop --reporter=list"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "katex": "^0.18.1",
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "rehype-katex": "^7.0.1",
    "remark-cjk-friendly": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.0"
  }
}
