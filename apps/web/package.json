{
  "name": "kloudchat-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:unit": "vitest run src",
    "preview": "vite preview",
    "test:config": "node --test tests/vite-config.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --config playwright.ci.config.ts",
    "test:personas": "playwright test e2e/personas.spec.ts --reporter=list",
    "test:auth": "playwright test e2e/auth.spec.ts --project=desktop --reporter=list",
    "test:chat": "playwright test e2e/chat.spec.ts --project=desktop --reporter=list",
    "test:workspace": "playwright test e2e/workspace.spec.ts --project=desktop --reporter=list",
    "test:journeys": "playwright test e2e/persona-journeys.spec.ts --project=desktop --reporter=list",
    "test:work-audit": "playwright test e2e/work-scenario-catalog.spec.ts e2e/persona-journeys.spec.ts --project=desktop --reporter=list",
    "test:regress": "playwright test e2e/regress.spec.ts --project=desktop --reporter=list"
  },
  "dependencies": {
    "@fontsource/nanum-myeongjo": "^5.3.0",
    "@fontsource/pretendard": "^5.3.0",
    "@rhwp/editor": "0.9.0",
    "@stll/docx-core": "0.43.1",
    "@stll/folio-core": "0.69.0",
    "@stll/folio-react": "0.34.1",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.54.0",
    "mermaid": "^12.1.0",
    "pagedjs": "^0.4.3",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.13",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.5",
    "prosemirror-view": "^1.42.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-katex": "^7.0.1",
    "remark-cjk-friendly": "^2.3.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "use-intl": "^4.15.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.87.0",
