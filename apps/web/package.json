{
  "name": "kloudchat-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:unit": "vitest run src",
    "preview": "vite preview",
    "test:config": "node --test tests/vite-config.test.mjs && playwright test -c playwright.ci.config.ts --list > /dev/null",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --config playwright.ci.config.ts",
    "test:personas": "playwright test e2e/personas.spec.ts --reporter=list",
    "test:auth": "playwright test e2e/auth.spec.ts --project=desktop --reporter=list",
    "test:chat": "playwright test e2e/chat.spec.ts --project=desktop --reporter=list",
    "test:workspace": "playwright test e2e/workspace.spec.ts --project=desktop --reporter=list",
    "test:journeys": "playwright test e2e/persona-journeys.spec.ts --project=desktop --reporter=list",
    "test:work-audit": "playwright test e2e/work-scenario-catalog.spec.ts e2e/persona-journeys.spec.ts --project=desktop --reporter=list",
    "test:regress": "playwright test e2e/regress.spec.ts --project=desktop --reporter=list",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@fontsource/nanum-gothic": "5.3.0",
    "@fontsource/nanum-myeongjo": "^5.3.0",
    "@fontsource/pretendard": "^5.3.0",
    "@rhwp/editor": "0.9.0",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-text-align": "^3.33.1",
    "@tiptap/extension-text-style": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@xyflow/react": "^12.12.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.72.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "^12.3.0",
    "micromark-extension-cjk-friendly": "^2.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "ooxml-core": "1.49.0",
    "ooxml-ui": "1.49.1",
    "open-docx-editor": "0.7.6",
    "pagedjs": "^0.4.3",
    "pptx-react-viewer": "4.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "rehype-katex": "^7.0.1",
    "remark-cjk-friendly": "^2.3.4",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.93.0",
    "patch-package": "8.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
