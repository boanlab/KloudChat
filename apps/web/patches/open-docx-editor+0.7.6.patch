@@ -0,0 +1,45 @@
+// kloudchat-odx-patch: i18n
+// The editor's own words (ribbon, menus, find bar, dialogs, screen-reader messages) in the host's language. Each is
+// looked up by its English text; one with no entry stays in English. `setLocale('ko')` picks a built-in dictionary,
+// `setLabels({...})` adds to or overrides it. A locale's `patterns` ([RegExp, replacement]) translate messages made
+// from parts ("3 fields updated"); a "Label: detail" text with no entry of its own is translated part by part.
+import { KO, KO_PATTERNS } from './locales/ko.js';
+
+const LOCALES = { ko: [KO, KO_PATTERNS] };
+let dict = {};
+let patterns = [];
+
+/** The built-in dictionary for `locale` ('ko', 'ko-KR'; anything else is English). */
+export function setLocale(locale) {
+  const [words, pats] = LOCALES[String(locale || '').toLowerCase().split('-')[0]] || [{}, []];
+  dict = { ...words };
+  patterns = pats;
+}
+
+/** Entries that add to or override the current dictionary. */
+export function setLabels(labels) { Object.assign(dict, labels || {}); }
+
+const fill = (s, vars) => (vars ? s.replace(/\{(\w+)\}/g, (m, k) => (k in vars ? String(vars[k]) : m)) : s);
+
+function lookup(text) {
+  if (Object.prototype.hasOwnProperty.call(dict, text)) return dict[text];
+  // (Spaces around a label, "Left " before its field: kept, the label translated.)
+  const m = /^(\s*)(.*?)(\s*)$/s.exec(text);
+  if ((m[1] || m[3]) && m[2] && Object.prototype.hasOwnProperty.call(dict, m[2])) return m[1] + dict[m[2]] + m[3];
+  for (const [re, to] of patterns) {
+    if (re.test(text)) return text.replace(re, typeof to === 'function' ? (...a) => to(t, ...a) : to);
+  }
+  const i = text.indexOf(': ');
+  if (i > 0) {
+    const a = text.slice(0, i), b = text.slice(i + 2);
+    const ta = lookup(a), tb = lookup(b);
+    if (ta != null || tb != null) return `${ta ?? a}: ${tb ?? b}`;
+  }
+  return null;
+}
+
+/** `text` in the current language (its `{name}` placeholders filled from `vars`), or as it is when there is no entry. */
+export function t(text, vars) {
+  if (typeof text !== 'string' || !text) return text;
+  return fill(lookup(text) ?? text, vars);
+}
