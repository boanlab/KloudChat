+/** The editor's own words in the current language ({name} placeholders filled from vars); English when there is no entry. */
+export function t(text: string, vars?: Record<string, string | number>): string;
+/** Picks a built-in dictionary: 'ko' (or 'ko-KR') for Korean; anything else is English. */
+export function setLocale(locale: string | null | undefined): void;
+/** Adds entries to, or overrides entries of, the current dictionary. */
+export function setLabels(labels: Record<string, string> | null | undefined): void;
diff --git a/node_modules/open-docx-editor/src/editor/i18n.js b/node_modules/open-docx-editor/src/editor/i18n.js
