# ── app ──────────────────────────────────────────────────────────────────
ENV=dev
CORS_ORIGINS=["http://localhost:5173"]

# ── database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://kchat:kchat@localhost:5433/kchat

# ── auth ─────────────────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=change-me-to-32-random-bytes
# open = active immediately · approval = admin must approve · closed = no signup
SIGNUP_MODE=approval
DEFAULT_MONTHLY_CREDITS=20000
# Set to true behind TLS. Off on plain-HTTP localhost or the cookie is dropped.
COOKIE_SECURE=false

# ── downstream ───────────────────────────────────────────────────────────
# Never exposed to the browser. kchat calls LiteLLM server-side with this key.
LITELLM_BASE_URL=http://localhost:8000
LITELLM_MASTER_KEY=
